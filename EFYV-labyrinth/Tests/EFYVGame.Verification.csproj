<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Shared\EFYV.Runtime.Media\**\*.cs" Exclude="..\..\Shared\EFYV.Runtime.Media\bin\**;..\..\Shared\EFYV.Runtime.Media\obj\**;..\..\Shared\EFYV.Runtime.Media\BuildOutput~\**" LinkBase="EFYV.Runtime.Media" />
    <Compile Include="..\..\EFYV-labybackend\Core\**\*.cs" Exclude="..\..\EFYV-labybackend\Core\bin\**;..\..\EFYV-labybackend\Core\obj\**;..\..\EFYV-labybackend\Core\BuildOutput~\**" LinkBase="Backend" />
    <Compile Include="..\Assets\Scripts\**\*.cs" LinkBase="Game" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\..\..\..\EFYV-runtime-kernel\bindings\dotnet\Efyv.RuntimeKernel\Efyv.RuntimeKernel.csproj')">
    <ProjectReference Include="..\..\..\..\..\EFYV-runtime-kernel\bindings\dotnet\Efyv.RuntimeKernel\Efyv.RuntimeKernel.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\..\..\EFYV-runtime-kernel\bindings\dotnet\Efyv.RuntimeKernel\Efyv.RuntimeKernel.csproj')">
    <Reference Include="Efyv.RuntimeKernel">
      <HintPath>..\..\Shared\EFYV.Runtime.Kernel.Unity\Runtime\Managed\Efyv.RuntimeKernel.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
