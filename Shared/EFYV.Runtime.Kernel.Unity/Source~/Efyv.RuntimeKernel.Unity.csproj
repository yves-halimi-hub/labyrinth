<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Efyv.RuntimeKernel</AssemblyName>
    <RootNamespace>Efyv.RuntimeKernel</RootNamespace>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Runtime\Managed\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\..\..\EFYV-runtime-kernel\bindings\dotnet\Efyv.RuntimeKernel\RuntimeKernel.cs"
             Link="Official\RuntimeKernel.cs" />
    <Compile Include="NetStandardCompatibility.cs" />
  </ItemGroup>
</Project>
